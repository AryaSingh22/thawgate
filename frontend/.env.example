# Copy to .env.local (gitignored). Every VITE_* value ends up in the public JavaScript bundle.

# RPC. Default: public devnet (https://api.devnet.solana.com). A keyed URL (Helius, …) is for your machine only:
# `npm run build` refuses one. Never commit it and never deploy a build that carries it.
# VITE_RPC_URL=

# Adds an in-page burner wallet to the wallet list. Devnet tests only: its key lives in the page and is lost on reload.
# VITE_BURNER_WALLET=1

# Legacy API panels at /ops (mint-service, indexer, compliance, webhooks).
# VITE_MINT_API_URL=http://localhost:3001
# VITE_INDEXER_API_URL=http://localhost:3002
# VITE_COMPLIANCE_API_URL=http://localhost:3003
# VITE_WEBHOOK_API_URL=http://localhost:3004
