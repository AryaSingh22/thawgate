{
    "name": "@thawgate/sdk",
    "version": "0.1.0",
    "description": "TypeScript SDK for ThawGate: Token ACL gate policies, SSS-ACL stablecoins, SAS credentials",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AryaSingh22/thawgate.git",
        "directory": "sdk"
    },
    "homepage": "https://github.com/AryaSingh22/thawgate#readme",
    "bugs": {
        "url": "https://github.com/AryaSingh22/thawgate/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./reasons": {
            "import": {
                "types": "./dist/reasons.d.mts",
                "default": "./dist/reasons.mjs"
            },
            "require": {
                "types": "./dist/reasons.d.ts",
                "default": "./dist/reasons.js"
            }
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "reasons": [
                "./dist/reasons.d.ts"
            ]
        }
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts"
    },
    "dependencies": {
        "@coral-xyz/anchor": "^0.32.1",
        "@solana/spl-token": "^0.4.14",
        "@solana/web3.js": "^1.98.4",
        "@types/bn.js": "^5.1.6",
        "bn.js": "^5.2.1"
    },
    "devDependencies": {
        "@solana/kit": "^5",
        "@token-acl/sdk": "0.2.7",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^10.0.1",
        "sas-lib": "1.0.10",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vitest": "^4.0.18"
    }
}