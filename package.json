{
  "name": "thawgate",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaSingh22/thawgate.git"
  },
  "homepage": "https://github.com/AryaSingh22/thawgate#readme",
  "bugs": {
    "url": "https://github.com/AryaSingh22/thawgate/issues"
  },
  "workspaces": [
    "sdk",
    "cli",
    "services/shared",
    "services/mint-service",
    "services/indexer",
    "services/compliance-service",
    "services/webhook-service",
    "tests"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "test:unit": "npx cross-env ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 npx ts-mocha tests/unit/*.test.ts",
    "test:cargo": "cargo test --workspace",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspace @thawgate/sdk build && yarn workspace @thawgate/shared build && yarn workspaces run typecheck"
  },
  "devDependencies": {
    "@orca-so/whirlpools": "8.0.1",
    "@orca-so/whirlpools-client": "7.0.0",
    "@orca-so/whirlpools-core": "3.1.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.73-alpha",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token-2022": "0.6.1",
    "@solana/kit": "^5",
    "@solana/token-acl-gate-sdk": "^0.3.1",
    "@token-acl/sdk": "0.2.7",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "mocha": "^5.0.5",
    "sas-lib": "1.0.10",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "eslint": "10.0.1",
    "fastify": "^4.26.2"
  }
}
